# caches and logs
__pycache__/
logs/
# run outputs, plan banks and caches: large or regenerable (trajopt_drift.py / cache_lqr.py / the schedulers)
*.npz
*.npy
*.done
runs/**/log.jsonl
runs_aborted*/
