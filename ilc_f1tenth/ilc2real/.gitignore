# the mu 0.2 drift plans (not their LQR gain caches), every sim stage's final network, and the per-car networks of
# the end-product videos (figs/videos/)
!runs/*/policy_final.npz
!runs/hw/v3nom_s0_hw24/real_*_policy.npz
!runs/hw/ppo_dr_lap2/real_*_policy.npz
