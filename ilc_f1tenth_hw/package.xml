<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ilc_f1tenth_hw</name>
  <version>0.1.0</version>
  <description>ILC2Real F1TENTH hardware layer: OptiTrack + VESC IMU state estimation (EKF), the drive relay / watchdog, and
    the VESC current-control patches for f1tenth_system (ported from LLA-Control/LLA-MPC-onboard).</description>
  <maintainer email="hzl@andrew.cmu.edu">Henry Liao</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>vesc_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>natnet_ros2</exec_depend>
  <exec_depend>f1tenth_stack</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
