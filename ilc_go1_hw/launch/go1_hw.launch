<!-- The Go1's ROS 1 hardware layer. By default it publishes joints, IMU and
     leg-derived velocity for the workstation EKF. The old onboard estimation
     path remains available as an explicit fallback. -->
<launch>
  <arg name="mocap_topic" default="/dl_go1/pose"
       doc="NatNet PoseStamped topic from the workstation (bridged ROS 2 -> ROS 1)"/>
  <arg name="use_onboard_ekf" default="false"/>
  <arg name="cmd_topic" default="joint_cmd_r" doc="joint_cmd for a ROS 1 controller"/>
  <arg name="lowlevel" default="true" doc="false: estimation only (e.g. the robot in sport mode, for tests)"/>

  <rosparam file="$(find ilc_go1_hw)/config/go1_hw.yaml" command="load"/>

  <node if="$(arg lowlevel)" pkg="ilc_go1_hw" type="go1_lowlevel_node" name="go1_lowlevel" output="screen"
        required="true">
    <!-- commands from the ROS 2 controller arrive through joint_cmd_relay.py + ros1_bridge as joint_cmd_r -->
    <remap from="joint_cmd" to="$(arg cmd_topic)"/>
  </node>

  <node if="$(arg use_onboard_ekf)" pkg="ilc_go1_hw" type="mocap_odom_node.py" name="mocap_odom" output="screen">
    <param name="mocap_topic" value="$(arg mocap_topic)"/>
  </node>

  <!-- the IMU site is the trunk origin (Menagerie go1.xml) -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="trunk_to_imu" args="0 0 0 0 0 0 trunk imu_link"/>

  <node if="$(arg use_onboard_ekf)" pkg="robot_localization" type="ekf_localization_node" name="ekf_trunk" output="screen">
    <rosparam command="load" file="$(find ilc_go1_hw)/config/ekf.yaml"/>
    <remap from="odometry/filtered" to="trunk/odometry"/>
  </node>
</launch>
